# 이 파일을 .env로 복사한 뒤 값을 채워 쓴다. 이 파일에는 실제 값을 적지 않는다.
# Claude 상담카드(즉답·확인 질문)와 "Claude로 바로 답변"에서만 쓴다. Claude 호출은 lib/llm.ts 한 곳에서 한다.
# 서버 코드에서만 읽으므로 이름에 NEXT_PUBLIC_을 붙이지 않는다.

# Claude API 키
ANTHROPIC_API_KEY=

# Claude API 주소. 비워 두면 Anthropic 기본 주소를 쓴다(사내 프록시 등을 거칠 때만 채운다)
ANTHROPIC_BASE_URL=

# 상담카드와 [빠른 답변]에 쓸 가볍고 빠른 모델 이름
CLAUDE_MODEL_FAST=

# [보통 답변]에 쓸 더 꼼꼼한 모델 이름
CLAUDE_MODEL_NORMAL=
